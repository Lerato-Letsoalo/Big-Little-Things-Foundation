# Dependencies
node_modules/

# Environment variables
.env
.env.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/

# Uploaded files — keep the folders, ignore the contents
uploads/team/*
!uploads/team/.gitkeep
uploads/gallery/*
!uploads/gallery/.gitkeep
uploads/donations/*
!uploads/donations/.gitkeep

# Proof-of-payment documents are always private — never committed
uploads/proofs/*
!uploads/proofs/.gitkeep

# Build output
dist/
build/

# Certs (optional — safe to commit public CA, uncomment to exclude)
# certs/*.pem